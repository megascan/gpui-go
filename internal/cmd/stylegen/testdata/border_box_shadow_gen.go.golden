	style := s.self.Style()
	style.BorderWidths.Top = gpuiutil.Some(Px(24.).ToAbsoluteLength())
	style.BorderWidths.Bottom = gpuiutil.Some(Px(24.).ToAbsoluteLength())
	return s.self
}

// BorderY32 sets the border width of the horizontal sides of the element. [Docs](https://tailwindcss.com/docs/border-width#horizontal-and-vertical-sides)
//
// 32px
func (s *Styled[S]) BorderY32() S {
	style := s.self.Style()
	style.BorderWidths.Top = gpuiutil.Some(Px(32.).ToAbsoluteLength())
	style.BorderWidths.Bottom = gpuiutil.Some(Px(32.).ToAbsoluteLength())
	return s.self
}

// Shadow sets the box shadow of the element.
// [Docs](https://tailwindcss.com/docs/box-shadow)
func (s *Styled[S]) Shadow(shadows []BoxShadow) S {
	s.self.Style().BoxShadow = gpuiutil.Some(shadows)
	return s.self
}

// ShadowNone clears the box shadow of the element.
// [Docs](https://tailwindcss.com/docs/box-shadow)
func (s *Styled[S]) ShadowNone() S {
	s.self.Style().BoxShadow = gpuiutil.Some([]BoxShadow(nil))
	return s.self
}

// Shadow2xs sets the box shadow of the element.
// [Docs](https://tailwindcss.com/docs/box-shadow)
func (s *Styled[S]) Shadow2xs() S {
	s.self.Style().BoxShadow = gpuiutil.Some([]BoxShadow{
		NewBoxShadow(Px(0.), Px(1.), NewHsla(0., 0., 0., 0.05)),
	})
	return s.self
}

// ShadowXs sets the box shadow of the element.
// [Docs](https://tailwindcss.com/docs/box-shadow)
func (s *Styled[S]) ShadowXs() S {
	s.self.Style().BoxShadow = gpuiutil.Some([]BoxShadow{
		NewBoxShadow(Px(0.), Px(1.), NewHsla(0., 0., 0., 0.05)).BlurRadius(Px(2.)),
	})
	return s.self
}

// ShadowSm sets the box shadow of the element.
// [Docs](https://tailwindcss.com/docs/box-shadow)
func (s *Styled[S]) ShadowSm() S {
	s.self.Style().BoxShadow = gpuiutil.Some([]BoxShadow{
		NewBoxShadow(Px(0.), Px(1.), NewHsla(0., 0., 0., 0.1)).BlurRadius(Px(3.)),
		NewBoxShadow(Px(0.), Px(1.), NewHsla(0., 0., 0., 0.1)).BlurRadius(Px(2.)).SpreadRadius(Px(-1.)),
	})
	return s.self
}

